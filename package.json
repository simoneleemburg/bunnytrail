{
	"name": "bunnytrail",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"description": "Knowledge-graph engine for personal compendiums. Drives the Alteria worldbuilding site.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/simoneleemburg/bunnytrail.git"
	},
	"files": [
		"dist",
		"bin",
		"scripts"
	],
	"bin": {
		"bunnytrail": "./bin/bunnytrail.ts"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./routes/*": {
			"types": "./dist/routes/*.d.ts",
			"svelte": "./dist/routes/*",
			"default": "./dist/routes/*"
		},
		"./components/*": {
			"types": "./dist/components/*.d.ts",
			"svelte": "./dist/components/*",
			"default": "./dist/components/*"
		},
		"./server/*": {
			"types": "./dist/server/*.d.ts",
			"default": "./dist/server/*"
		},
		"./styles/*": "./dist/styles/*",
		"./assets/*": "./dist/assets/*",
		"./types": {
			"types": "./dist/types.d.ts",
			"default": "./dist/types.js"
		},
		"./cluster": {
			"types": "./dist/cluster.d.ts",
			"svelte": "./dist/cluster.js",
			"default": "./dist/cluster.js"
		},
		"./hooks": {
			"types": "./dist/hooks.d.ts",
			"default": "./dist/hooks.js"
		}
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package",
		"prepublishOnly": "npm run package",
		"prepare": "svelte-kit sync && svelte-package || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"smoke:sample": "BUNNYTRAIL_WORLD_DIR=$PWD/sample-world tsx --tsconfig tsconfig.json scripts/smoke-sample-world.ts",
		"test": "vitest run",
		"test:watch": "vitest",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"peerDependencies": {
		"@sveltejs/kit": "^2.0.0",
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.57.0",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^7.0.0",
		"@types/d3-force": "^3.0.10",
		"@types/d3-selection": "^3.0.11",
		"@types/d3-zoom": "^3.0.8",
		"@types/node": "^22.10.0",
		"prettier": "^3.4.0",
		"prettier-plugin-svelte": "^3.3.0",
		"svelte": "^5.55.2",
		"svelte-check": "^4.4.6",
		"typescript": "^6.0.2",
		"vite": "^8.0.7",
		"vitest": "^4.1.8"
	},
	"dependencies": {
		"@vercel/analytics": "^2.0.1",
		"chokidar": "^4.0.0",
		"d3-force": "^3.0.0",
		"d3-selection": "^3.0.0",
		"d3-zoom": "^3.0.0",
		"dotenv": "^17.4.2",
		"marked": "^15.0.0",
		"node-fetch": "^3.3.2",
		"tsx": "^4.22.3",
		"vm2": "^3.11.5",
		"yaml": "^2.6.0"
	}
}
